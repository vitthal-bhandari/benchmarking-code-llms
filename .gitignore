# Secrets / environment
.env

# Tillicum serving/driver venvs (built by install_venv.sh / install_venv_new.sh;
# requirements-*.txt snapshots are the tracked record instead)
.venv/
.venv-new/
agent-venv/

# OS junk
.DS_Store

# Python
__pycache__/
*.pyc

# Local-only Claude Code handoff notes (never pushed)
CLAUDE_CODE_HANDOFF.md

# Experiment outputs — heavy generated artifacts (agent trajectories, preds,
# per-run logs). Kept locally, never pushed. Scored summaries live in results/.
# runs/

# Runtime, node-specific vLLM endpoint overrides (regenerated each run;
# see configs/api_override.example.yaml for the format)
configs/api_override.yaml
configs/api_override_gemma4.yaml

# Local Docker-based SWE-bench scoring (scripts/install_eval_venv.sh /
# run_local_eval.sh). eval-venv is a local Python venv (regenerate via
# install_eval_venv.sh; requirements-eval.txt is the tracked snapshot).
# local_eval/ is the harness's own working dir (build/run logs, per-instance
# test output, converted preds) — heavy and fully reproducible from
# runs/*/preds.json; the final report JSONs it produces are copied out to
# local-eval-reports/, which IS tracked.
eval-venv/
local_eval/

# Klone Apptainer-based SWE-bench scoring (scripts/install_klone_eval_venv.sh /
# run_apptainer_eval.slurm). klone-eval-venv is a local venv on Klone
# (requirements-klone-eval.txt is the tracked snapshot). The runner's SCRATCH
# working dir (.sif images, overlays, staged patch/eval files — heavy but
# trivially regenerable) defaults to ./apptainer_eval at the repo root and
# should be pointed at /gscratch/scrubbed instead; anchored to root so it does
# NOT catch logs/apptainer_eval/, which holds the durable per-instance
# report.json/apply.log/exec.log/test_output.log and IS tracked (same
# untrusted-scratch reasoning as logs/ generally — see README).
klone-eval-venv/
/apptainer_eval/

# Rendered trajectory HTML (regenerable via scripts/render_trajectory_html.py)
site/
logs/vllm_serve_inline_332111.log
logs/vllm_serve_inline_*.log

# Heavy per-instance artifacts from EPHEMERAL runs. preds.json and
# memory_trace.json are what the analysis actually reads (a few MB total);
# *.traj.json and raw_messages.json are only needed to RENDER a trajectory, and
# at ~150MB per 99-instance run they were the bulk of a 2.8GB tracked tree --
# enough to make GitHub's merge API time out on PR #74. Smoke runs never need
# them; superseded full runs get pruned by hand once they stop being the latest.
# Default OFF: a run's trajectories are ignored unless deliberately kept. Runs
# already tracked (the latest 99-instance 3446xx set, the *_verified baselines,
# run_qwen_100_*) are unaffected -- .gitignore never untracks. To keep a NEW
# run's trajectories, add them explicitly:
#     git add -f runs/<run>/*/*.traj.json runs/<run>/*/raw_messages.json
runs/**/*.traj.json
runs/**/raw_messages.json

# Generated by scripts/make_table.py; regenerate rather than track a stale copy.
# Commit the final one deliberately once Klone scoring has filled in Pass@1:
#     git add -f table.tex table.md
/table.tex
/table.md
