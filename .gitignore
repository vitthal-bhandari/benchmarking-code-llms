# Secrets / environment
.env

# OS junk
.DS_Store

# Python
__pycache__/
*.pyc

# Local-only Claude Code handoff notes (never pushed)
CLAUDE_CODE_HANDOFF.md

# Experiment outputs — heavy generated artifacts (agent trajectories, preds,
# per-run logs). Kept locally, never pushed. Scored summaries live in results/.
# runs/

# Runtime, node-specific vLLM endpoint overrides (regenerated each run;
# see configs/api_override.example.yaml for the format)
configs/api_override.yaml
configs/api_override_gemma4.yaml

# Local Docker-based SWE-bench scoring (scripts/install_eval_venv.sh /
# run_local_eval.sh). eval-venv is a local Python venv (regenerate via
# install_eval_venv.sh; requirements-eval.txt is the tracked snapshot).
# local_eval/ is the harness's own working dir (build/run logs, per-instance
# test output, converted preds) — heavy and fully reproducible from
# runs/*/preds.json; the final report JSONs it produces are copied out to
# local-eval-reports/, which IS tracked.
eval-venv/
local_eval/

# Klone Apptainer-based SWE-bench scoring (scripts/install_klone_eval_venv.sh /
# run_apptainer_eval.slurm). klone-eval-venv is a local venv on Klone
# (requirements-klone-eval.txt is the tracked snapshot). The runner's heavy
# working state (.sif images, overlays, per-instance logs) lives on
# /gscratch/scrubbed, not in the repo; only the final report in
# local-eval-reports/ is tracked.
klone-eval-venv/
apptainer_eval/
