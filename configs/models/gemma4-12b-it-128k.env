# google/gemma-4-12B-it — cross-family comparison (11.95B, LiveCodeBench 72.0).
# MUST be the -it (instruction-tuned) variant: the base google/gemma-4-12B has no
# chat template / tool-calling, so mini-swe-agent's bash protocol fails on turn 1.
# Known friction from the earlier Gemma4 work (see report.md): reasoning-tag
# runaway needs a larger MAX_TOKENS, multimodal forces MAX_NUM_BATCHED_TOKENS,
# and it serves on the newer vLLM stack.
MODEL_NAME=google/gemma-4-12B-it
AGENT_MODEL_NAME=hosted_vllm/google/gemma-4-12B-it
SERVE_VENV=.venv-new
TOOL_CALL_PARSER=gemma4
MAX_NUM_BATCHED_TOKENS=4096
# vendor card: one standardized preset for all use cases
TEMPERATURE=1.0
TOP_P=0.95
TOP_K=64
SEED=0
# 128k sweep point: usable prompt 122,880: usable prompt 122,880 (= CONTEXT_CAP - MAX_TOKENS), identical for all models
MAX_TOKENS=8192
MAX_MODEL_LEN=131072
CONTEXT_CAP=131072
SUMMARIZE_AT=124518
KEEP_LAST_K=3
