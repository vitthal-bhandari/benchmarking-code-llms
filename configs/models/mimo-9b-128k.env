# XiaomiMiMo/MiMo-V2.6-Distill-Qwen-9B — an SFT of Qwen3.5-9B, so pairing it with
# qwen35-9b.env isolates the POST-TRAINING RECIPE at identical base and size.
# SWE-bench Verified 61.1 (vendor). Thinking-heavy -> larger output reservation.
# RISK: vendor docs demonstrate SGLang with `--reasoning-parser mimo`; vLLM
# support for that parser is unverified. Smoke-test before committing GPU hours;
# if vLLM rejects it, try REASONING_PARSER=deepseek_r1 (generic <think> splitter)
# or drop it and set ENABLE_THINKING=false.
MODEL_NAME=XiaomiMiMo/MiMo-V2.6-Distill-Qwen-9B
AGENT_MODEL_NAME=hosted_vllm/XiaomiMiMo/MiMo-V2.6-Distill-Qwen-9B
SERVE_VENV=.venv
TOOL_CALL_PARSER=qwen3_coder
REASONING_PARSER=mimo
TEMPERATURE=0.6
TOP_P=0.95
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=0.0
REPETITION_PENALTY=1.0
SEED=0
# 128k sweep point: usable prompt 122,880: usable prompt 122,880 (= CONTEXT_CAP - MAX_TOKENS), identical for all models
MAX_TOKENS=8192
MAX_MODEL_LEN=131072
CONTEXT_CAP=131072
SUMMARIZE_AT=124518
KEEP_LAST_K=3
