# Qwen/Qwen3.5-9B — PRIMARY. Direct successor to the Qwen3.6-35B-A3B baseline:
# same family, same tokenizer lineage, same validated coding sampling preset.
# Thinking mode ON (vendor's coding preset is a thinking preset); the extra
# reasoning tokens are legitimate context pressure for a memory study.
MODEL_NAME=Qwen/Qwen3.5-9B
AGENT_MODEL_NAME=hosted_vllm/Qwen/Qwen3.5-9B
SERVE_VENV=.venv
TOOL_CALL_PARSER=qwen3_coder
REASONING_PARSER=qwen3
# "Thinking mode for precise coding tasks" (vendor HF card)
TEMPERATURE=0.6
TOP_P=0.95
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=0.0
REPETITION_PENALTY=1.0
SEED=0
# 64k budget: usable prompt 57,344 (= CONTEXT_CAP - MAX_TOKENS), identical for all models
MAX_TOKENS=8192
MAX_MODEL_LEN=65536
CONTEXT_CAP=65536
SUMMARIZE_AT=57344
KEEP_LAST_K=3
